<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="40dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Service status -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="28dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/dot" />

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_text"
                style="@style/RowSummary"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/open_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_accent"
                android:stateListAnimator="@null"
                android:text="@string/open_settings"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Log access missing -->
        <LinearLayout
            android:id="@+id/logs_card"
            style="@style/Card"
            android:layout_marginTop="12dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logs_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/logs_title"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/RowSummary"
                android:layout_marginTop="6dp"
                android:text="@string/logs_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/code_bg"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="@string/logs_command"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Notification access missing (seek) -->
        <LinearLayout
            android:id="@+id/notif_card"
            style="@style/Card"
            android:layout_marginTop="12dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/notif_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/notif_title"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/RowSummary"
                android:layout_marginTop="6dp"
                android:text="@string/notif_text" />

            <Button
                android:id="@+id/open_notif_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_accent"
                android:stateListAnimator="@null"
                android:text="@string/open_notif_settings"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Features -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_features" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:id="@+id/row_bixby"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/feature_bixby" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/feature_bixby_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_bixby"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_volume"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/feature_volume" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/feature_volume_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_volume"
                    style="@style/Toggle" />
            </LinearLayout>
        </LinearLayout>

        <!-- Track skip options -->
        <TextView
            style="@style/SectionLabel"
            android:text="@string/section_track_skip" />

        <LinearLayout
            android:id="@+id/track_card"
            style="@style/Card">

            <LinearLayout
                android:id="@+id/row_apps"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/feature_apps" />

                    <TextView
                        android:id="@+id/apps_summary"
                        style="@style/RowSummary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/chevron"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_hold"
                style="@style/SliderRow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/feature_hold" />

                    <TextView
                        android:id="@+id/hold_value"
                        style="@style/SliderValue" />
                </LinearLayout>

                <TextView
                    style="@style/RowSummary"
                    android:text="@string/feature_hold_summary" />

                <SeekBar
                    android:id="@+id/hold_slider"
                    style="@style/Slider" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_seek"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/feature_seek" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/feature_seek_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_seek"
                    style="@style/Toggle" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_seek_step"
                style="@style/SliderRow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/feature_seek_step" />

                    <TextView
                        android:id="@+id/seek_step_value"
                        style="@style/SliderValue" />
                </LinearLayout>

                <TextView
                    style="@style/RowSummary"
                    android:text="@string/feature_seek_step_summary" />

                <SeekBar
                    android:id="@+id/seek_step_slider"
                    style="@style/Slider" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/row_seek_ramp"
                style="@style/SettingRow">

                <LinearLayout style="@style/SettingText">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/feature_seek_ramp" />

                    <TextView
                        style="@style/RowSummary"
                        android:text="@string/feature_seek_ramp_summary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_seek_ramp"
                    style="@style/Toggle" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
